# APP_URL: Public URL where SurveyLand is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Optional national-source credentials
# -----------------------------------------------------------------------------
# Denmark: Datafordeleren Matriklen2 WFS. Keep this API key server-side only.
# Without it, Danish cadastral lookup fails closed and the report asks for verification.
# DATAFORDELER_API_KEY="MY_DATAFORDELER_API_KEY"

# -----------------------------------------------------------------------------
# Optional AI evidence interpretation
# -----------------------------------------------------------------------------
# Hosted Mistral is the default provider. Keep this key server-side only.
AI_INTERPRETATION_PROVIDER="mistral"
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
MISTRAL_MODEL="ministral-8b-2512"

# Local/self-hosted alternative. Set AI_INTERPRETATION_PROVIDER="ollama" to use it.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="ministral-3:8b"

# AI calls require Firebase sign-in by default. The backend validates each ID token
# with Firebase Auth before calling Mistral/Ollama. This is the Firebase Web API key.
FIREBASE_WEB_API_KEY="MY_FIREBASE_WEB_API_KEY"

# Vite client-side Firebase config. These identifiers are public Firebase web-app
# configuration, not server secrets. Enable Google sign-in in Firebase Auth.
VITE_FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
# Optional Firebase web-app fields:
# VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"

# -----------------------------------------------------------------------------
# Persistent AI allowance and Paddle credit packs
# -----------------------------------------------------------------------------
# When enabled, each signed-in user gets 25 successful AI interpretations before
# purchased credits are required. Usage is stored in Firestore, not the browser.
AI_QUOTA_ENFORCEMENT="true"
AI_FREE_REPORT_LIMIT="25"
AI_QUOTA_FIRESTORE_PROJECT_ID="MY_FIREBASE_OR_GCP_PROJECT_ID"
# Optional Firestore overrides:
# AI_QUOTA_FIRESTORE_DATABASE_ID="(default)"
# AI_QUOTA_FIRESTORE_COLLECTION="surveylandAiEntitlements"
# AI_QUOTA_TRANSACTION_COLLECTION="surveylandPaddleTransactions"

# On Cloud Run, the quota service uses the runtime service account via the Google
# metadata server. Give that service account permission to read/write Firestore.
# For local integration testing only, a short-lived OAuth access token may be used:
# AI_QUOTA_FIRESTORE_ACCESS_TOKEN="SHORT_LIVED_GOOGLE_OAUTH_TOKEN"

# Paddle starts disabled and in sandbox mode so no real money is charged. Create a sandbox API
# key, client-side token, product, one-time price and notification destination in Paddle,
# then set the IDs here. Turn on PADDLE_BILLING_ENABLED only after the sandbox flow is tested.
PADDLE_BILLING_ENABLED="false"
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY="MY_PADDLE_SANDBOX_API_KEY"
PADDLE_CLIENT_TOKEN="MY_PADDLE_SANDBOX_CLIENT_TOKEN"
PADDLE_AI_CREDIT_PRICE_ID="pri_MY_SANDBOX_PRICE_ID"
AI_CREDIT_PACK_SIZE="50"

# Paddle sends transaction.completed notifications here. Store the secret from the
# Paddle notification destination server-side; the endpoint verifies raw-body signatures.
# PADDLE_WEBHOOK_SECRET="MY_PADDLE_NOTIFICATION_SECRET"

# Local development only. Do NOT enable this on a public deployment unless you
# deliberately want an unauthenticated model endpoint.
# AI_INTERPRETATION_ALLOW_ANONYMOUS="true"

# Legacy/optional Gemini key retained for any existing AI Studio integrations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

